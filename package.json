{
  "name": "fourward",
  "version": "1.0.0",
  "private": true,
  "description": "FOURWARD — その一歩が、武器になる。 4方向に装備を割り当てるターン制ダンジョン探索RPG",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch --serve",
    "serve": "node tools/serve.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "sim": "node tools/sim.ts",
    "e2e": "node tools/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
